# ========================================================
# SpamOut Backend Environment Configuration
# Copy this file to '.env' and fill in your values.
# ========================================================

# Email Daemon (IMAP / SMTP Configuration)
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ACCOUNT=your-support-email@gmail.com
EMAIL_PASSWORD=your-google-app-password
CHECK_INTERVAL=10

# VirusTotal Scanner API
VT_API_KEY=your-virustotal-api-key

# Flask Web API
PORT=5000
FLASK_DEBUG=True
FLASK_SECRET_KEY=change-this-in-production-to-a-random-secret
GOOGLE_CLIENT_SECRETS_FILE=./credentials.json
