# ========================================================
# SpamOut Environment Configuration Template
# Copy this file to '.env' and fill in your values.
# ========================================================

# Email Daemon (IMAP / SMTP Configuration)
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ACCOUNT=your-email@gmail.com
EMAIL_PASSWORD=your-google-app-password
ALLOWED_DOMAIN=@gmail.com
CHECK_INTERVAL=5

# Google API Configuration
GOOGLE_CLIENT_SECRETS_FILE=./credentials.json
GMAIL_API_KEY=your-gmail-api-key

# VirusTotal Scanner API
VT_API_KEY=your-virustotal-api-key
VT_API_ENDPOINT=https://www.virustotal.com/vtapi/v2/file/report

# Storage Paths
ATTACHMENT_SAVE_PATH=./attachments
QUARANTINE_PATH=./quarantine

