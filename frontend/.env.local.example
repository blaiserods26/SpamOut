# ========================================================
# SpamOut Frontend Environment Configuration
# Copy this file to '.env.local' and fill in your values.
# ========================================================

# Application Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth Credentials
NEXT_PUBLIC_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-secure-nextauth-secret
